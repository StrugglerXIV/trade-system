{
  "id": "trade-system",
  "title": "MMORPG-Style Trade System",
  "type": "module",
  "description": "Secure player-to-player trading with dual-panel confirmation for D&D 5e.",
  "version": "1.0.2",
  "authors": [{"name": "Denis"}],
  "socket": true,
  "scripts": [
    "scripts/token-trade.mjs",
    "scripts/sockets.mjs",
    "scripts/trade-helpers.mjs",
